{
  "name": "quant-terminal",
  "private": true,
  "version": "0.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/web",
    "start": "npm run build -w apps/web && node scripts/dev.mjs --built",
    "engine:setup": "node scripts/engine.mjs setup",
    "engine:dev": "node scripts/engine.mjs dev",
    "engine:test": "node scripts/engine.mjs test",
    "package": "node scripts/package.mjs"
  }
}
